# Optional. Leave unset in development: the Vite dev server proxies
# /health, /evaluate and /demo to the FastAPI backend (same origin).
# Set it only when the backend is served from a different origin, in which
# case that backend must allow the origin through CORS.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional, read by vite.config.js (not exposed to the browser):
# CODEGUARD_API_TARGET=http://127.0.0.1:8000
